@@ -0,0 +1,72 @@
+// Spike only. Snapshots a tree's presentation output, so a tick's merged walk can be compared with a settled refresh.
+type Kids = (n: object) => ArrayLike<object>;
+type Snap = Map<string, string>;
+interface ProbeState { frames: number; staleFrames: number; }
+const g = globalThis as unknown as { __mergeProbe?: unknown; __probeContext?: string; __probeStats?: Map<string, ProbeState>; __vitest_worker__?: { current?: { name?: string; file?: { name?: string } } }; __noteHiddenUpdate?: (n: object) => void };
+function contextNow(): string {
+    if (g.__probeContext !== undefined) return g.__probeContext;
+    const current = g.__vitest_worker__?.current;
+    return `${String(current?.file?.name ?? '?').replace(/^.*[\/]/, '')} > ${String(current?.name ?? '?')}`.replace(/\s+/g, '_');
+}
+const hiddenSeen = new Set<string>();
+g.__noteHiddenUpdate = (node: object): void => {
+    const key = `${contextNow()} ${describe(node as Record<string, unknown>)}`;
+    if (hiddenSeen.has(key)) return;
+    hiddenSeen.add(key);
+    console.log(`[HIDDEN-UPDATE] ${key}`);
+};
+const seen = new Set<string>();
+g.__probeStats = new Map();
+
+function describe(node: Record<string, unknown>): string {
+    const label = node.label ?? node.name ?? node.tagName ?? (node.constructor as { name?: string } | undefined)?.name;
+    return String(label === '' || label === undefined ? 'node' : label);
+}
+function read(node: any): string {
+    const p = node.position;
+    const r = node.rotation;
+    const s = node.scale;
+    const parts = [
+        p?.x, p?.y, p?.z,
+        typeof r === 'number' ? r : r?.x, r?.y, r?.z,
+        s?.x, s?.y, s?.z,
+        node.alpha, node.visible, node.tint, node.text, node.texture?.uid, node.material?.opacity,
+        typeof node.getAttribute === 'function' ? node.getAttribute('style') : undefined,
+        typeof node.getAttribute === 'function' ? node.getAttribute('class') : undefined,
+        node.nodeType !== undefined ? node.textContent?.slice(0, 80) : undefined,
+    ];
+    return parts.map((v) => (typeof v === 'number' ? Math.round(v * 1e4) / 1e4 : String(v))).join('|');
+}
+function walk(node: any, kids: Kids, path: string, out: Snap): void {
+    out.set(path, read(node));
+    const list = kids(node);
+    out.set(`${path}#kids`, String(list.length));
+    for (let i = 0; i < list.length; i++) walk(list[i], kids, `${path}/${describe(list[i] as Record<string, unknown>)}[${i}]`, out);
+}
+g.__mergeProbe = {
+    snapshot(root: object, kids: Kids): Snap {
+        const out: Snap = new Map();
+        walk(root, kids, describe(root as Record<string, unknown>), out);
+        return out;
+    },
+    compare(before: Snap, root: object, kids: Kids): void {
+        const after: Snap = new Map();
+        walk(root, kids, describe(root as Record<string, unknown>), after);
+        const context = contextNow();
+        let stats = g.__probeStats!.get(context);
+        if (stats === undefined) g.__probeStats!.set(context, stats = { frames: 0, staleFrames: 0 });
+        stats.frames++;
+        let isStale = false;
+        for (const [path, value] of after) {
+            const was = before.get(path);
+            if (was === value) continue;
+            isStale = true;
+            const key = `${context} ${path.replace(/\[\d+\]/g, '')}`;
+            if (seen.has(key)) continue;
+            seen.add(key);
+            console.log(`[PROBE] ${context} frame=${stats.frames} ${path} :: ${was} => ${value}`);
+        }
+        if (isStale) stats.staleFrames++;
+    },
+};
+export {};
