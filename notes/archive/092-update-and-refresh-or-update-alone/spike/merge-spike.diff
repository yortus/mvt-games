+// Spike only: the positive controls for the merged walk's staleness probe.
+import { Container } from 'pixi.js';
+import { expect, it } from 'vitest';
+import { refreshView, setRefresh, setUpdate, updateView } from './index';
+
+const stats = (): Map<string, { frames: number; staleFrames: number }> =>
+    (globalThis as unknown as { __probeStats: Map<string, { frames: number; staleFrames: number }> }).__probeStats;
+const setContext = (name: string): void => { (globalThis as { __probeContext?: string }).__probeContext = name; };
+
+it('sees a parent that shows its child\'s presentation state', () => {
+    setContext('control-parent-reads-child');
+    const parent = new Container();
+    const child = new Container();
+    parent.addChild(child);
+    let childMs = 0;
+    setUpdate(child, (deltaMs) => { childMs += deltaMs; });
+    setRefresh(parent, () => { parent.x = childMs; });
+    for (let i = 0; i < 10; i++) { updateView(parent, 16); refreshView(parent); }
+    console.log('[CONTROL]', JSON.stringify(stats().get('control-parent-reads-child')));
+    expect(stats().get('control-parent-reads-child')?.staleFrames).toBeGreaterThan(0);
+});
+
+it('sees a command from a later view, read by an earlier one', () => {
+    setContext('control-relay-mid-walk');
+    const root = new Container();
+    const board = new Container();
+    const keypad = new Container();
+    root.addChild(board, keypad);
+    const model = { digit: 0 };
+    setRefresh(board, () => { board.x = model.digit; });
+    setUpdate(keypad, () => { model.digit++; });
+    for (let i = 0; i < 10; i++) { updateView(root, 16); refreshView(root); }
+    console.log('[CONTROL]', JSON.stringify(stats().get('control-relay-mid-walk')));
+    expect(stats().get('control-relay-mid-walk')?.staleFrames).toBeGreaterThan(0);
+});
+
+it('stays quiet for a parent\'s state, which its children read after it updates', () => {
+    setContext('control-child-reads-parent');
+    const parent = new Container();
+    const child = new Container();
+    parent.addChild(child);
+    let parentMs = 0;
+    setUpdate(parent, (deltaMs) => { parentMs += deltaMs; });
+    setRefresh(child, () => { child.x = parentMs; });
+    for (let i = 0; i < 10; i++) { updateView(parent, 16); refreshView(parent); }
+    console.log('[CONTROL]', JSON.stringify(stats().get('control-child-reads-parent')));
+    expect(stats().get('control-child-reads-parent')?.staleFrames).toBe(0);
+});
