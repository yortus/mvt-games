{
    "name": "mvt-games",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "checks"
    ],
    "scripts": {
        "prepare": "npm run generate-refresh-copies && npm run build:lint-plugin",
        "predev": "npm run generate-refresh-copies",
        "dev": "npm run dev -w @mvtjs/website",
        "prebuild": "npm run generate-refresh-copies",
        "build": "tsc -b && npm run build -w @mvtjs/website && npm run build -w @mvtjs/docs",
        "prebuild:website": "npm run generate-refresh-copies",
        "build:website": "tsc -b && npm run build -w @mvtjs/website",
        "build:docs": "npm run build -w @mvtjs/docs",
        "build:packages": "npm run build -w @mvtjs/utils -w @mvtjs/pixi -w @mvtjs/three -w @mvtjs/html && node checks/scripts/published-view-types.ts",
        "build:lint-plugin": "npm run build -w @mvtjs/eslint-plugin",
        "docs:dev": "npm run dev -w @mvtjs/docs",
        "preview": "npm run preview -w @mvtjs/website",
        "prelint": "npm run build:lint-plugin",
        "lint": "eslint .",
        "prelint:fix": "npm run build:lint-plugin",
        "lint:fix": "eslint . --fix",
        "release": "changeset version && npm install --package-lock-only",
        "prebench": "npm run generate-refresh-copies",
        "bench": "tsx packages/benchmarks/run.ts",
        "pretest": "npm run generate-refresh-copies",
        "test": "vitest run",
        "test:watch": "vitest",
        "generate-textures": "npm run generate-textures -w @mvtjs/website",
        "generate-refresh-copies": "npm run generate-refresh-copies -w @mvtjs/utils"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^9.39.4",
        "@mvtjs/eslint-plugin": "^0.1.0",
        "@stylistic/eslint-plugin": "^5.5.0",
        "eslint": "^9.39.4",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "happy-dom": "^20.14.5",
        "publint": "^0.3.25",
        "tsdown": "^0.23.0",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^8.3.2",
        "vitest": "^5.0.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.59.0"
    }
}
