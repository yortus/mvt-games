{
    "name": "mvt-games",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "imports": {
        "#common": "./src/common/index.ts"
    },
    "scripts": {
        "prepare": "npm run generate-refresh-copies",
        "predev": "npm run generate-refresh-copies",
        "dev": "vite --host",
        "prebuild": "npm run generate-refresh-copies",
        "build": "tsc -b && vite build && vitepress build docs",
        "prebuild:site": "npm run generate-refresh-copies",
        "build:site": "tsc -b && vite build",
        "build:docs": "vitepress build docs",
        "docs:dev": "vitepress dev docs --port 5200",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prebench": "npm run generate-refresh-copies",
        "bench": "tsx benchmarks/run.ts",
        "pretest": "npm run generate-refresh-copies",
        "test": "vitest run",
        "test:watch": "vitest",
        "generate-textures": "tsx scripts/generate-textures.ts",
        "generate-refresh-copies": "npm run generate-refresh-copies -w @mvtjs/utils"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@stylistic/eslint-plugin": "^5.5.0",
        "@types/glob": "^8.1.0",
        "@types/lz-string": "^1.3.34",
        "@types/pngjs": "^6.0.5",
        "@types/three": "^0.186.0",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.4",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "glob": "^13.0.6",
        "happy-dom": "^20.14.5",
        "mermaid": "^11.13.0",
        "pngjs": "^7.0.0",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.6",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.43.13",
        "@mvtjs/html": "^0.1.0",
        "@mvtjs/pixi": "^0.1.0",
        "@mvtjs/three": "^0.1.0",
        "@mvtjs/utils": "^0.1.0",
        "codemirror": "^6.0.2",
        "gsap": "^3.14.2",
        "lz-string": "^1.5.0",
        "pixi-solid": "^1.0.0",
        "pixi.js": "^8.16.0",
        "solid-js": "^1.9.11",
        "sucrase": "^3.35.1",
        "three": "^0.186.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.59.0"
    }
}
