{
    "name": "mvt-games",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*/*"
    ],
    "imports": {
        "#eslint-plugin": "./packages/tools/eslint-plugin/src/index.ts"
    },
    "scripts": {
        "dev": "npm run dev -w @mvtjs/arcade",
        "dev:https": "npm run dev:https -w @mvtjs/arcade",
        "build": "tsc -b && npm run build -w @mvtjs/arcade && npm run check:home-page-budget && npm run build -w @mvtjs/docs",
        "build:arcade": "tsc -b && npm run build -w @mvtjs/arcade && npm run check:home-page-budget",
        "build:docs": "npm run build -w @mvtjs/docs",
        "build:packages": "npm run build -w @mvtjs/utils -w @mvtjs/pixi -w @mvtjs/three -w @mvtjs/html && npm run check:view-type-registration",
        "check:home-page-budget": "npm run check:home-page-budget -w @mvtjs/checks",
        "check:view-type-registration": "npm run check:view-type-registration -w @mvtjs/checks",
        "docs:dev": "npm run dev -w @mvtjs/docs",
        "preview": "npm run preview -w @mvtjs/arcade",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "release": "changeset version && npm install --package-lock-only",
        "bench": "tsx packages/tests/benchmarks/run.ts",
        "test": "vitest run",
        "test:unit": "vitest run -p unit",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:visual": "vitest run -p \"visual-*\"",
        "test:visual:update": "vitest run -p \"visual-*\" -u",
        "test:vsnap": "npm test -w v-snap",
        "generate-textures": "npm run generate-textures -w @mvtjs/arcade",
        "audio:render": "npm run render-wav -w @mvtjs/audio --",
        "generate-thumbnails": "npm run generate-thumbnails -w @mvtjs/arcade --",
        "measure-load": "npm run measure-load -w @mvtjs/arcade --"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^9.39.4",
        "@stylistic/eslint-plugin": "^5.5.0",
        "@vitest/browser-playwright": "^5.0.3",
        "@vitest/ui": "^5.0.3",
        "eslint": "^9.39.4",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "happy-dom": "^20.14.5",
        "jiti": "^2.7.0",
        "playwright": "~1.64.1",
        "publint": "^0.3.25",
        "tsdown": "^0.23.0",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^8.3.2",
        "vitest": "^5.0.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.59.0"
    }
}
