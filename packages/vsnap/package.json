{
    "name": "vsnap",
    "version": "0.0.0",
    "private": true,
    "description": "Fast, consistent visual snapshot tests for Pixi, three.js and HTML views: the same images on Windows, Linux and macOS, with no Docker",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "default": "./src/browser/index.ts"
        },
        "./config": {
            "default": "./src/node/index.ts"
        }
    },
    "bin": {
        "vsnap": "./bin/vsnap.js"
    },
    "scripts": {
        "test:visual": "tsx src/node/cli/vsnap.ts",
        "test:visual:update": "tsx src/node/cli/vsnap.ts --update",
        "test:visual:environment": "tsx src/node/cli/vsnap.ts --environment",
        "test:visual:check-references": "tsx src/node/cli/check-references.ts",
        "test:visual:fixture": "cd fixtures/visual-tests-folders && vsnap",
        "generate-blank-font": "tsx src/node/cli/generate-blank-font.ts"
    },
    "dependencies": {
        "@vitest/browser-playwright": "^5.0.3",
        "fontkit": "^2.0.4",
        "playwright": "1.63.0",
        "pngjs": "^7.0.0",
        "tsx": "^4.21.0"
    },
    "peerDependencies": {
        "pixi.js": "^8.16.0",
        "three": "^0.186.1",
        "vitest": "^5.0.3"
    },
    "devDependencies": {
        "@types/fontkit": "^2.0.9",
        "@types/pngjs": "^6.0.5",
        "@types/three": "^0.186.0",
        "vite": "^8.3.2"
    }
}
