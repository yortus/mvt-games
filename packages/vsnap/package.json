{
    "name": "vsnap",
    "version": "0.0.0",
    "private": true,
    "description": "Fast, consistent visual snapshot tests for Pixi, three.js and HTML views: the same images on Windows, Linux and macOS, with no Docker",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "default": "./src/browser/index.ts"
        },
        "./config": {
            "default": "./src/node/index.ts"
        }
    },
    "scripts": {
        "test": "vitest run",
        "test:unit": "vitest run -p unit",
        "test:visual": "vitest run -p \"visual-*\"",
        "test:visual:update": "vitest run -p \"visual-*\" -u",
        "test:visual:environment": "tsx src/node/cli/environment.ts",
        "generate-blank-font": "tsx src/node/cli/generate-blank-font.ts"
    },
    "dependencies": {
        "@vitest/browser-playwright": "^5.0.3",
        "fontkit": "^2.0.4",
        "playwright": "~1.63.0",
        "pngjs": "^7.0.0"
    },
    "peerDependencies": {
        "pixi.js": "^8.16.0",
        "three": "^0.186.1",
        "vitest": "^5.0.3"
    },
    "devDependencies": {
        "@types/fontkit": "^2.0.9",
        "@types/pngjs": "^6.0.5",
        "@types/three": "^0.186.0",
        "tsx": "^4.21.0",
        "vite": "^8.3.2"
    }
}
