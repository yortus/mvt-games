{
    "name": "@mvtjs/arcade",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "exports": {
        "./entries": "./src/entries/index.ts",
        "./entry-types": "./src/entry-types/index.ts",
        "./entries/falling-sand/models": "./src/entries/falling-sand/models/index.ts",
        "./entries/falling-sand/views": "./src/entries/falling-sand/views/index.ts"
    },
    "imports": {
        "#highscores": "./src/highscores/index.ts",
        "#shared": "./src/shared/index.ts",
        "#pixel-glyphs": "./src/pixel-glyphs/index.ts",
        "#tunes": "./src/tunes/index.ts"
    },
    "scripts": {
        "dev": "vite --host",
        "dev:https": "vite --host --mode https",
        "build": "vite build",
        "preview": "vite preview",
        "generate-textures": "tsx scripts/generate-textures.ts",
        "generate-thumbnails": "tsx scripts/generate-thumbnails.ts",
        "measure-load": "tsx scripts/measure-load.ts",
        "highscores:dev": "wrangler dev -c highscores-worker/wrangler.toml --env test",
        "highscores:deploy": "wrangler deploy -c highscores-worker/wrangler.toml",
        "highscores:deploy:test": "wrangler deploy -c highscores-worker/wrangler.toml --env test",
        "highscores:types": "wrangler types -c highscores-worker/wrangler.toml --include-env=false highscores-worker/worker-configuration.d.ts"
    },
    "dependencies": {
        "@mvtjs/chiptune": "^0.4.0",
        "@mvtjs/html": "^0.4.0",
        "@mvtjs/pixi": "^0.4.0",
        "@mvtjs/three": "^0.4.0",
        "@mvtjs/utils": "^0.4.0",
        "gsap": "^3.14.2",
        "pixi-solid": "^1.0.0",
        "pixi.js": "^8.16.0",
        "solid-js": "^1.9.11",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/node": "^26.6.3",
        "@types/pngjs": "^6.0.5",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "glob": "^13.0.6",
        "pngjs": "^7.0.0",
        "tsx": "^4.21.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.1",
        "v-snap": "*",
        "wrangler": "^4.148.0"
    }
}
