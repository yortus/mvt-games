{
    "name": "@mvtjs/pixi-3d",
    "version": "0.0.0",
    "private": true,
    "description": "MVT (Model-View-Ticker) for PixiJS 3D: updateView and refreshView over its scene nodes, a JSX runtime, and bridges between 2D and 3D. Private while PixiJS 3D is in beta",
    "license": "MIT",
    "author": "Troy Gerwien",
    "keywords": ["mvt", "model-view-ticker", "game", "pixi", "pixi.js", "3d", "jsx"],
    "homepage": "https://yortus.com/mvt-games/docs/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yortus/mvt-games.git",
        "directory": "packages/libraries/pixi-3d"
    },
    "bugs": { "url": "https://github.com/yortus/mvt-games/issues" },
    "type": "module",
    "sideEffects": [
        "./src/index.ts",
        "./src/container3d-mixin.ts",
        "./src/screen-render-system.ts",
        "./src/jsx/jsx-runtime.ts",
        "./dist/index.js",
        "./dist/container3d-mixin.js",
        "./dist/screen-render-system.js",
        "./dist/jsx/jsx-runtime.js"
    ],
    "exports": {
        ".": {
            "@mvtjs/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./jsx-runtime": {
            "@mvtjs/source": "./src/jsx/jsx-runtime.ts",
            "types": "./dist/jsx/jsx-runtime.d.ts",
            "default": "./dist/jsx/jsx-runtime.js"
        },
        "./jsx-dev-runtime": {
            "@mvtjs/source": "./src/jsx/jsx-dev-runtime.ts",
            "types": "./dist/jsx/jsx-dev-runtime.d.ts",
            "default": "./dist/jsx/jsx-dev-runtime.js"
        }
    },
    "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx", "!src/jsx/test-model.ts"],
    "scripts": {
        "build": "tsdown"
    },
    "peerDependencies": {
        "@mvtjs/pixi": "^0.10.0",
        "@mvtjs/utils": "^0.10.0",
        "@pixi/3d": "0.1.0",
        "pixi.js": "^8.23.0"
    },
    "devDependencies": {
        "tsdown": "^0.23.0",
        "vitest": "^5.0.1"
    },
    "publishConfig": { "access": "public" }
}
