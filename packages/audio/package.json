{
    "name": "@mvtjs/audio",
    "version": "0.0.0",
    "private": true,
    "description": "Virtual audio chips: the Audio80, a sound chip in the spirit of the 1980s home computers, with its tracker notation and the players that audio views use",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "@mvtjs/source": "./src/index.ts"
        },
        "./web": {
            "@mvtjs/source": "./src/web/index.ts"
        },
        "./headless": {
            "@mvtjs/source": "./src/headless/index.ts"
        }
    },
    "scripts": {
        "render-wav": "tsx --conditions=@mvtjs/source scripts/render-wav.ts"
    },
    "devDependencies": {
        "tsx": "^4.21.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.1"
    }
}
