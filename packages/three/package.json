{
    "name": "@mvtjs/three",
    "version": "0.1.0",
    "description": "MVT (Model-View-Ticker) for three.js: updateView and refreshView over its objects, a pointer picker, and a JSX runtime at ./jsx",
    "license": "MIT",
    "author": "Troy Gerwien",
    "keywords": ["mvt", "model-view-ticker", "game", "three", "three.js", "jsx"],
    "homepage": "https://yortus.com/mvt-games/docs/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yortus/mvt-games.git",
        "directory": "packages/three"
    },
    "bugs": { "url": "https://github.com/yortus/mvt-games/issues" },
    "type": "module",
    "sideEffects": ["./src/object3d-mixin.ts", "./dist/object3d-mixin.js"],
    "exports": {
        ".": {
            "@mvtjs/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./jsx": {
            "@mvtjs/source": "./src/jsx/index.ts",
            "types": "./dist/jsx/index.d.ts",
            "default": "./dist/jsx/index.js"
        },
        "./jsx/jsx-runtime": {
            "@mvtjs/source": "./src/jsx/jsx-runtime.ts",
            "types": "./dist/jsx/jsx-runtime.d.ts",
            "default": "./dist/jsx/jsx-runtime.js"
        },
        "./jsx/jsx-dev-runtime": {
            "@mvtjs/source": "./src/jsx/jsx-dev-runtime.ts",
            "types": "./dist/jsx/jsx-dev-runtime.d.ts",
            "default": "./dist/jsx/jsx-dev-runtime.js"
        }
    },
    "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
    "scripts": {
        "build": "tsdown"
    },
    "peerDependencies": {
        "@mvtjs/utils": "^0.1.0",
        "@types/three": ">=0.186.0",
        "three": ">=0.186.0"
    },
    "peerDependenciesMeta": {
        "@types/three": { "optional": true }
    },
    "devDependencies": {
        "@types/three": "^0.186.0",
        "tsdown": "^0.23.0",
        "vitest": "^5.0.1"
    },
    "publishConfig": { "access": "public" }
}
